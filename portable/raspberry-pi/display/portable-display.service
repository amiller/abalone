[Unit]
Description=Dsmack terminal-first disposable desktop
Requires=tor-guest-firewall.service portable-native-terminal.service systemd-logind.service
Wants=portable-workspace-ui.service
After=tor-guest-firewall.service portable-native-terminal.service portable-workspace-ui.service systemd-logind.service systemd-user-sessions.service
Conflicts=getty@tty1.service
After=getty@tty1.service
# Finish stopping the console shell (and its tty1 hangup) before Sway takes tty1.
After=portable-operator-shell.service
OnSuccess=portable-operator-shell.service
OnFailure=portable-operator-shell.service

[Service]
Type=simple
User=portable-ui
Group=portable-ui
SupplementaryGroups=portable-ipc
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
RuntimeDirectory=portable-display
RuntimeDirectoryMode=0700
Environment=HOME=/var/lib/portable/portable-ui
Environment=XDG_RUNTIME_DIR=/run/portable-display
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_DESKTOP=sway
Environment=LIBSEAT_BACKEND=logind
Environment=PATH=/opt/portable/bin:/usr/bin:/bin
WorkingDirectory=/run/portable-display
ExecStart=/usr/bin/python3 -I /opt/portable/portable/raspberry-pi/display/sway-runtime.py
Restart=no
KillMode=control-group
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/portable-display
# Wallet data lives in the unlocked vault (ui/wallet is created on first run).
ReadWritePaths=-/run/portable-vault/ui
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=graphical.target
