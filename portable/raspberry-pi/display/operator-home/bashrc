case $- in *i*) ;; *) return ;; esac
unset HISTFILE
HISTSIZE=0
HISTFILESIZE=0
export HOME=/root PATH=/usr/bin:/bin
PS1='dsmack:\w# '
# Rows 1-2 are the live status (console-status.py); the shell scrolls in rows 3.. with
# origin mode on, and commands get the full screen back.
PROMPT_COMMAND='printf "\e7\e[3r\e[?6h\e8"'
PS0='\e7\e[?6l\e[r\e8'
printf '\e[H\e[2J\e[3r\e[?6h\n'
printf '%s\n' 'Dsmack operator shell: the top two lines update by themselves.' \
  '  ~/agent    AI agent, not saved      ~/desktop  graphical desktop (Super+Shift+E comes back)' \
  '  ~/agent save  AI agent, session saved to the vault   ~/agent resume  pick a saved session' \
  '  ~/unlock   open the vault           ~/lock     close the vault       ~/status  vault state' \
  '  ~/credit   inference credit         ~/fund     add credit with ZEC   ~/fund --new  fresh demo' \
  '  ~/pseudonym new|exit|login|whoami NAME, ~/pseudonym list   Zcash t-address identities on Free2Z, via Nym' ''
(/usr/bin/python3 -I /opt/portable/portable/raspberry-pi/display/console-status.py watch $$ </dev/null &)
