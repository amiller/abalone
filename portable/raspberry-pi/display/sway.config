# Dsmack terminal-first desktop with separate UI and agent identities.
# Run only as an unprivileged account with no vault-control/credit authority.
set $mod Mod4
set $display /opt/portable/portable/raspberry-pi/display
set $term foot --font=monospace:pixelsize=14
set $native /usr/bin/python3 $display/native-terminal-client.py --socket /run/portable-native-terminal/control.sock --agent-uid 970
font pango:monospace 7
floating_modifier $mod normal
focus_follows_mouse no
# Hiding the idle pointer also ends hover; see the Zkool for_window nudge below.
seat * hide_cursor 1000
# Sway ignores /etc/default/keyboard.
input type:keyboard xkb_layout us
default_border pixel 0
gaps inner 0
# Scale 2 makes Zkool (Flutter/GTK ignores GDK_SCALE on Wayland) readable at 1080p; font sizes above are halved to match.
output * bg #111815 solid_color scale 2
client.focused #78c9a2 #1b3025 #e2f4e9 #78c9a2 #78c9a2
client.unfocused #263a30 #15221a #99b3a2 #263a30 #263a30

# The native Pi agent (same program as ~/agent, UID970) opens tiled under the status bar.
# --hold keeps its last output, including a locked-vault message, on screen.
# The first workspace binding (Super+A) names the initial workspace 1:agent.
exec $term --hold --app-id=portable-agent $native --agent
bindsym $mod+a workspace 1:agent, exec $term --hold --app-id=portable-agent $native --agent
bindsym $mod+Return fullscreen disable, exec $term --app-id=portable-terminal $native
# ~/fund as root (fund-terminal-daemon.py), floating over the right half: the QR needs about 40 columns.
for_window [app_id="portable-fund"] floating enable, resize set 55 ppt 90 ppt, move position 45 ppt 5 ppt
bindsym $mod+z fullscreen disable, exec $term --hold --app-id=portable-fund /usr/bin/python3 $display/native-terminal-client.py --socket /run/portable-fund-terminal/control.sock --agent-uid 970 --fund
# Zkool wallet (view-only, Tor transport); output goes to the journal, a locked vault shows a swaynag bar.
bindsym $mod+w workspace 3:wallet, exec /opt/portable/bin/dsmack-wallet
# Zkool wraps its whole page in a hover tooltip, and Sway re-enters the hidden pointer when the window maps;
# the nudge re-arms hide_cursor, which then ends the hover so the tooltip does not stick.
for_window [app_id="cc.methyl.zkool"] fullscreen enable, seat * cursor move 1 1
# Leaving Sway restarts the root operator console (portable-display.service OnSuccess/OnFailure).
bindsym $mod+Shift+e exit
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+q kill
bindsym $mod+1 workspace 1:agent
bindsym $mod+2 workspace 2:browser
bindsym $mod+3 workspace 3:wallet
bindsym $mod+Shift+1 move container to workspace 1:agent
bindsym $mod+Shift+2 move container to workspace 2:browser
bindsym $mod+Shift+3 move container to workspace 3:wallet
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+h splith
bindsym $mod+v splitv
bindsym $mod+e layout toggle split

# Browser starts only on request. Keep its sandbox and a session-only profile.
# Target assembly must verify XDG_RUNTIME_DIR is owned/private and RAM-backed.
bindsym $mod+b workspace 2:browser, exec /usr/bin/python3 $display/browser-ram-launcher.py

# Same live line as the console: Tor bootstrap and exit IP, network, vault, credit.
bar {
    mode dock
    position top
    status_command /usr/bin/python3 -I $display/console-status.py bar
    colors {
        background #111815
        statusline #b9d8c5
        focused_workspace #78c9a2 #1b3025 #e2f4e9
        inactive_workspace #263a30 #15221a #99b3a2
    }
}

# Every binding stays visible at the bottom of the screen.
bar {
    id hints
    position bottom
    workspace_buttons no
    status_command exec /bin/sh $display/key-hints.sh
    colors {
        background #1b3025
        statusline #e2f4e9
    }
}
