[Unit]
Description=Dsmack desktop ~/fund terminal (root, fixed command)
After=local-fs.target

[Service]
Type=simple
User=root
RuntimeDirectory=portable-fund-terminal
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 -I /opt/portable/portable/raspberry-pi/display/fund-terminal-daemon.py --socket /run/portable-fund-terminal/control.sock --ui-uid 971
Restart=always
LimitCORE=0

[Install]
WantedBy=multi-user.target
