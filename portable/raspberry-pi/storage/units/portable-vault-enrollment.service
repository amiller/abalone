# SPDX-License-Identifier: MIT
[Unit]
Description=Dsmack local encrypted-storage setup on tty3
ConditionPathExists=/dev/tty3
After=systemd-tmpfiles-setup.service getty@tty3.service
Conflicts=getty@tty3.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /opt/portable/portable/raspberry-pi/storage/enrollment-vt.py
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty3
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UMask=0077
LimitCORE=0
LimitMEMLOCK=infinity
NoNewPrivileges=yes
# SYS_PTRACE permits the same PID1 namespace comparison as the financial lease;
# DAC_READ_SEARCH permits readback after the record becomes private to UID972.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
KillMode=control-group
TimeoutStopSec=10s
Environment=TERM=linux
# Host mount namespace is required, as with portable-vault-broker.service.
# No automatic enablement until native adapter and image qualification pass.
