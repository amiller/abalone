#!/bin/sh
# Fixed kernel/initramfs policy. Environment paths are trusted offline test seams.
set -efu
fail() { echo "portable-persistent-api: REFUSED: $*" >&2; exit 1; }
mode=${1:-check}; case "$mode" in establish|check) ;; *) fail 'unknown mode' ;; esac
sys=${PPA_SYS:-/sys}
mi=${PPA_MOUNTINFO:-/proc/self/mountinfo}
cmd=${PPA_CMDLINE:-/proc/cmdline}
cfg=${PPA_CONFIG:-/etc/portable-persistent-api.conf}
[ -f "$cfg" ] && [ ! -L "$cfg" ] || fail 'missing trusted configuration'
[ "$(wc -c < "$cfg")" -le 512 ] || fail 'configuration bound'
release=; pstore=
while IFS= read -r line || [ -n "$line" ]; do
 case "$line" in
  KERNEL_RELEASE=*) [ -z "$release" ] || fail 'duplicate release'; release=${line#*=} ;;
  PSTORE_MODE=builtin-disabled|PSTORE_MODE=absent) [ -z "$pstore" ] || fail 'duplicate mode'; pstore=${line#*=} ;;
  *) fail 'unknown configuration' ;;
 esac
done < "$cfg"
[ -n "$release" ] && [ "$release" = "$(uname -r)" ] && [ -n "$pstore" ] || fail 'kernel/config mismatch'
[ -r "$cmd" ] && [ "$(wc -c < "$cmd")" -le 16384 ] || fail 'cmdline unavailable/bound'
efi_count=0; pstore_count=0
for token in $(cat "$cmd"); do
 case "$token" in
  efi=noruntime) efi_count=$((efi_count+1)) ;;
  efi=*|noefi) fail 'conflicting EFI argument' ;;
  pstore.backend=none) pstore_count=$((pstore_count+1)) ;;
  pstore.backend=*) fail 'conflicting pstore backend' ;;
  --) fail 'init argument separator unsupported' ;;
 esac
done
[ "$efi_count" = 1 ] && [ "$pstore_count" = 1 ] || fail 'required kernel arguments missing/duplicated'
backend="$sys/module/pstore/parameters/backend"
if [ "$pstore" = builtin-disabled ]; then
 [ -f "$backend" ] && [ ! -L "$backend" ] && [ "$(cat "$backend")" = none ] || fail 'pstore backend not disabled'
 [ -d "$sys/fs/pstore" ] && [ ! -L "$sys/fs/pstore" ] || fail 'builtin pstore path absent'
else
 [ ! -e "$sys/module/pstore" ] && [ ! -e "$sys/fs/pstore" ] || fail 'unexpected pstore implementation'
fi
# The EFI driver may expose the mountpoint even with runtime disabled. No
# efivarfs filesystem registration is expected with the reviewed Linux kernel.
# Barriers avoid systemd's early automatic mount attempts at those paths.
check_mounts() {
 [ -r "$mi" ] && [ "$(wc -c < "$mi")" -le 1048576 ] || fail 'mount inventory unavailable/bound'
 awk -v sys="$sys" '
 function has(s,x) { return index("," s ",", "," x ",")>0 }
 BEGIN { bad=0; syscount=0 }
 {
  sep=0; for(i=7;i<=NF;i++) if($i=="-") {sep=i;break}
  if(NF<10 || sep<7 || NF!=sep+3) {bad=1;next}
  point=$5; kind=$(sep+1); super=$(sep+3)
  if(kind=="efivarfs" || kind=="pstore") bad=1
  if(point==sys) {syscount++;if(kind!="sysfs")bad=1}
  for(j=1;j<=2;j++) {
   target=(j==1 ? sys "/fs/pstore" : sys "/firmware/efi/efivars")
   if(point==target) {
    count[j]++
    if(kind!="tmpfs" || $4!="/" || !has($6,"ro") || has($6,"rw") || !has(super,"ro") || has(super,"rw") || !has($6,"nosuid") || !has($6,"nodev") || !has($6,"noexec")) bad=1
   } else if(index(point,target "/")==1) bad=1
   # An overmount of any intermediate ancestor could hide the sysfs target.
   if(point!=sys && point!="/" && index(target,point "/")==1) bad=1
  }
 }
 END {if(bad || syscount!=1 || count[1]>1 || count[2]>1)exit 1;print count[1]+0,count[2]+0}
 ' "$mi" || fail 'unexpected/stacked/writable persistent API mount'
}
counts=$(check_mounts); set -- $counts; first=$1; second=$2
for item in 'fs/pstore' 'firmware/efi/efivars'; do
 target="$sys/$item"
 if [ "$item" = fs/pstore ]; then count=$first; else count=$second; fi
 if [ ! -e "$target" ]; then [ "$count" = 0 ] || fail 'mount with absent target'; continue; fi
 [ -d "$target" ] && [ ! -L "$target" ] || fail 'unsupported API path'
 if [ "$count" = 0 ]; then
  [ "$mode" = establish ] || fail 'early barrier missing; no late repair'
  mount -t tmpfs -o ro,nosuid,nodev,noexec,size=4k,mode=000 portable-persistent-api "$target" || fail 'cannot establish readonly barrier'
 fi
done
counts=$(check_mounts); set -- $counts
[ ! -e "$sys/fs/pstore" ] || [ "$1" = 1 ] || fail 'pstore barrier missing'
[ ! -e "$sys/firmware/efi/efivars" ] || [ "$2" = 1 ] || fail 'EFI barrier missing'
echo 'portable-persistent-api: kernel policy and readonly barriers verified'
