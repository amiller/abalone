[Unit]
Description=Dsmack disposable agent backend
After=tor-guest-firewall.service portable-workspace.service
Requires=tor-guest-firewall.service portable-workspace.service

[Service]
Type=simple
User=portable-agent
Group=portable-agent
SupplementaryGroups=portable-ipc
Environment=PATH=/opt/portable/bin:/usr/bin:/bin
UMask=0077
RuntimeDirectory=portable-agent
RuntimeDirectoryMode=0755
ExecStart=/opt/portable/bin/node /opt/portable/portable/workspace-service/agent-service.mjs --workspace /run/portable-workspace --socket /run/portable-agent/agent.sock --allow-uid portable-ui --group portable-ipc
Restart=on-failure
KillMode=control-group
TimeoutStopSec=40
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/run/portable-agent /run/portable-workspace

[Install]
WantedBy=multi-user.target
