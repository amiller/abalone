[Unit]
Description=Dsmack session workspace in RAM
After=local-fs.target

[Service]
Type=oneshot
User=portable-agent
Group=portable-agent
SupplementaryGroups=
UMask=0077
RuntimeDirectory=portable-workspace
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/true
RemainAfterExit=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
