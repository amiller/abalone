#!/usr/bin/env bash
# The caller's end of the hardened mode: an MCP stdio server that is only a pipe to abalone-mcp's socket.
exec node -e 'const s = require("net").connect(process.argv[1]); process.stdin.pipe(s).pipe(process.stdout); s.on("close", () => process.exit(0)); s.on("error", (e) => { console.error(e.message); process.exit(1); })' "${1:?usage: abalone-connect <socket>}"
