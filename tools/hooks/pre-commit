#!/bin/sh
# Installed as .git/hooks/pre-commit (tools/agent-worktree.sh installs it; worktrees share it). Refuses imports of
# untracked files, then rehashes curated/manifest.json from the staged blobs and stages it, so every commit is consistent.
set -e
node tools/check-imports.mjs
node tools/manifest-index.mjs --write
