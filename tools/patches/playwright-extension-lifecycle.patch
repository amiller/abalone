+// Reconcile only our connection screens whose local relay has exited. A live
+// approval, a slow relay, and every ordinary user tab are preserved.
+async function cleanupAbandonedPairingPages(exceptTabId?: number): Promise<void> {
+  const pages = await chrome.tabs.query({ url: chrome.runtime.getURL('connect.html') + '*' });
+  await Promise.all(pages.map(async page => {
+    if (page.id === exceptTabId || page.id === undefined || !page.url) return;
+    let relay: URL;
+    try { relay = new URL(new URL(page.url).searchParams.get('mcpRelayUrl')!); } catch { return; }
+    if (relay.protocol !== 'ws:' || !['127.0.0.1', '[::1]'].includes(relay.hostname)) return;
+    try {
+      // A response of any HTTP status proves the server is still there. Do not
+      // send its pairing path/token, claim its WebSocket, or consume approval.
+      await fetch('http://' + relay.host + '/', { signal: AbortSignal.timeout(1200), cache: 'no-store' });
+    } catch (error: any) {
+      if (error.name === 'TypeError') await chrome.tabs.remove(page.id).catch(() => {});
+    }
+  }));
+}
